# Copy this file to .env.local for local development.
# In Vercel, set every one of these as a Project → Settings → Environment
# Variable instead — never commit real values.

# --- Database (Neon or Supabase Postgres connection string) -------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# The full site URL, no trailing slash. In Vercel this can be set to
# https://your-project.vercel.app or your custom domain.
NEXTAUTH_URL="http://localhost:3000"

# --- Discord OAuth app (Discord Developer Portal → your application) ------
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# The Goatem Studios Discord server's ID. Login is rejected for anyone who
# isn't currently a member of this guild.
DISCORD_GUILD_ID=""

# Comma-separated Discord role IDs (from that guild) mapped to app
# permission tiers. A person's tier is the HIGHEST tier any of their roles
# matches — see src/lib/permissions.ts. Anyone logged in but matching
# neither list still gets the base MEMBER tier (can view roster, file bug
# reports, comment).
DISCORD_ADMIN_ROLE_IDS=""
DISCORD_STAFF_ROLE_IDS=""

# --- Discord bot (optional — avatars + role colors) ------------------------
# A bot token for the SAME Discord Application as above (Developer Portal →
# your application → Bot → Reset Token). The bot must be invited to your
# guild (OAuth2 → URL Generator → check "bot" scope, minimal permissions is
# fine) for this to work. Powers real avatars and Discord role colors
# throughout the app (see src/lib/discordBot.ts) — everything degrades
# gracefully to placeholders if this is left blank.
DISCORD_BOT_TOKEN=""

# --- Audit log mirror (optional but strongly recommended) -----------------
# A Discord webhook URL (Server Settings → Integrations → Webhooks) for a
# private, staff-only channel. Every audited action gets posted here too,
# so there's a copy of the trail nobody inside the app can edit or clear.
# Leave blank to disable — the database audit log still works without it.
AUDIT_WEBHOOK_URL=""
